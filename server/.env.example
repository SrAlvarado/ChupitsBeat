# Credenciales para respaldar la caché de perfiles en Supabase (pgvector).
# Copia este fichero a server/.env y rellena la service_role key.
# Dashboard → Project Settings → API → Project URL / service_role key.

SUPABASE_URL=https://onocaxrqornukldmloyv.supabase.co
SUPABASE_SERVICE_KEY=

# Oyentes mensuales de Spotify (filtro de "emergente") se obtienen GRATIS con un
# navegador headless (Playwright), no necesita claves. Solo hay que instalarlo:
#   python -m playwright install chromium

# Opcional: token de Hugging Face para descargar CLAP sin límites de tasa.
# (también se lee del .env de la raíz si está allí)
# HF_TOKEN=
